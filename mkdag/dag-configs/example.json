{
  "dag": {
    "id": "gene_processing_dag",
    "description": "A DAG to process gene tables from an S3 bucket",
    "schedule_interval": "@daily",
    "start_date": "2025-01-01",
    "catchup": false,
    "default_args": {
      "retries": 3,
      "retry_delay": 5
    },
    "inputs": {
      "gene_data": "s3://my-bucket/raw/gene_table.tsv"
    },
    "outputs": {
      "transformed_data": "s3://my-bucket/processed/gene_table_cleaned.tsv"
    },
    "sensors": [
      {
        "id": "wait_for_gene_data",
        "type": "s3",
        "path": "s3://my-bucket/raw/gene_table.tsv",
        "mode": "poke",
        "poke_interval": 300,
        "timeout": 1800
      }
    ],
    "tasks": [
      {
        "id": "extract",
        "type": "python",
        "function": "tasks.extract_data",
        "inputs": ["gene_data"],
        "upstream": [
          { "task": "wait_for_gene_data", "condition": "on_success" }
        ]
      },
      {
        "id": "transform",
        "type": "databricks",
        "function": "tasks.transform_data",
        "inputs": ["gene_data"],
        "outputs": ["transformed_data"],
        "upstream": [
          { "task": "extract", "condition": "on_success" }
        ]
      },
      {
        "id": "load",
        "type": "kubernetes",
        "function": "tasks.load_data",
        "inputs": ["transformed_data"],
        "upstream": [
          { "task": "transform", "condition": "on_failure" }
        ]
      }
    ]
  }
}
